# Copie para .env (ou para um arquivo fora do repositório) e preencha. NUNCA faça commit do .env.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=reservice
MYSQL_PASSWORD=
# 32 caracteres ou mais (assinatura do JWT)
JWT_SEGREDO=
# 16 caracteres ou mais; a mesma chave vale para Backend 1 e Backend 2 (socket TCP)
CHAVE_INTERNA=
# Twilio (Backend 2, SMS de lembrete)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Opcionais
CORS_ORIGENS=http://localhost:5175
VITE_API_URL=http://localhost:8080
